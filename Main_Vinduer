#Requires AutoHotkey v2.0

; Forward-deklarasjon for å tilfredsstille #Warn i delte moduler
global PList

; ==============================================================================
; OMPROGRAMMERINGSTASTER PANEL (F1)
; ==============================================================================
TriggerF1Knappeoppsett() {
    global HK_Pause, HK_Extract, HK_Gui, HK_Speed, cfg
    try if IsObject(cfg) and WinExist("ahk_id " cfg.Hwnd)
        return LukkF1Oppsett()
    try {
        SoundPlay("*64")
        cfg := Gui("-Caption -Border +AlwaysOnTop +0x02000000")
        cfg.MarginX := 30, cfg.MarginY := 30, cfg.BackColor := "1A1A1A"
        cfg.SetFont("s10 cWhite Bold", "Segoe UI")
        cfg.Add("Text", "w270 h25 +0x200", "🔱 OMPROGRAMMERING TASTER:")
        cfg.SetFont("s9 cAAAAAA w400", "Segoe UI")
        cfg.Add("Text", "w120 xm y+15", "Pause-knapp:")
        iP := cfg.Add("Edit", "w140 x+10 r1 +Background333333 cWhite", HK_Pause)
        cfg.Add("Text", "w120 xm y+10", "Utpakk-knapp:")
        iE := cfg.Add("Edit", "w140 x+10 r1 +Background333333 cWhite", HK_Extract)
        cfg.Add("Text", "w120 xm y+10", "Vindus-knapp:")
        iG := cfg.Add("Edit", "w140 x+10 r1 +Background333333 cWhite", HK_Gui)
        cfg.Add("Text", "w120 xm y+10", "Farts-knapp:")
        iFart := cfg.Add("Edit", "w140 x+10 r1 +Background333333 cWhite", HK_Speed)
        cfg.SetFont("s9 cWhite Bold")
        cfg.Add("Button", "w270 h32 xm y+20 -Theme +Background3A3A3A", "💾 Lagre Knapper").OnEvent("Click", (btn, *)=>LagreNyeHurtigtaster(cfg, iP.Value, iE.Value, iG.Value, iFart.Value))
        cfg.Add("Button", "w270 h32 xm y+10 -Theme +Background3A3A3A", "🔄 Reset Standard").OnEvent("Click", (btn, *)=>LagreNyeHurtigtaster(cfg, "F2", "F3", "F6", "F7"))
        cfg.Add("Button", "w270 h32 xm y+10 -Theme +Background222222", "✖ Lukk Oppsett").OnEvent("Click", LukkF1Oppsett)
        OnMessage(0x0201, HåndterVinduKlikkF1)
        cfg.Show("W330")
    }
}

LukkF1Oppsett(*) {
    global cfg
    try {
        if IsObject(cfg) {
            cfg.Destroy()
            cfg := ""
        }
    } catch {
        global cfg := ""
    }
}

HåndterVinduKlikkF1(wParam, lParam, msg, hwnd) {
    global cfg
    try {
        if (IsObject(cfg) and hwnd = cfg.Hwnd) {
            PostMessage(0x00A1, 2, 0, , "ahk_id " cfg.Hwnd)
        }
    }
}

; ==============================================================================
; DET SENTRALE PASSORDSENTERET (F6)
; ==============================================================================
TriggerF6Senter() {
    global PList, PLB, EDF, SKF, MG, Lbl1, Lbl2, BtnA5, GullModus, Themes, StlIdx
    global btnDelAll, btnDelAllYes, btnDelAllNo, btnDelSel, btnDelSelYes, btnDelSelNo
    
    try if IsObject(MG) and WinExist("ahk_id " MG.Hwnd)
        return LukkVindusanleggMappe()
    try {
        SoundPlay("*64")
        MG := Gui("-Caption -Border +AlwaysOnTop +0x02000000")
        MG.MarginX := 30, MG.MarginY := 30
        st := Themes[StlIdx]
        MG.BackColor := st.bg
        MG.SetFont("s8.5 c000000 Bold", "Segoe UI")
        Lbl1 := MG.Add("Text", "x30 y30 w320 h30 +Border +BackgroundFFFFFF +0x200", " Lim inn passord manuelt:")
        MG.SetFont("s10 c" st.fg " Bold")
        EDF := MG.Add("Edit", "x30 y68 w320 h235 +VScroll -HScroll +Background" st.ft " c" st.fg " -WantReturn")
        EDF.OnEvent("Focus", HåndterEDFFokus)
        EDF.OnEvent("LoseFocus", HåndterEDFTapFokus)
        
        ; ⚡ LIVE OVERVÅKNING: Kobler tekstfeltet til overvåkningsmotoren for 4000-6000 tegn
        EDF.OnEvent("Change", OvervåkTekstLengdeLive)
        
        MG.SetFont("s9 cWhite Bold")
        MG.Add("Button", "x30 y318 w160 h32 -Theme +Background3A3A3A", "Legg til").OnEvent("Click", (btn, *)=>MassP(EDF.Value))
        MG.Add("Button", "x30 y360 w160 h32 -Theme +Background3A3A3A", "📋 Lim inn").OnEvent("Click", (btn, *)=>MassP(A_Clipboard))
        MG.Add("Button", "x30 y402 w160 h32 -Theme +Background3A3A3A", "🧹 Tøm Felt").OnEvent("Click", (btn, *) => TomManueltFelt())
        
        btnDelAll := MG.Add("Button", "x30 y444 w160 h32 -Theme +Background3A3A3A cRed", "💀 Nullstill Alt")
        btnDelAll.OnEvent("Click", VisFjernAlleValg)
        btnDelAllYes := MG.Add("Button", "x30 y444 w75 h32 -Theme +Background155724 cWhite +Hidden", "✔️ JA")
        btnDelAllYes.OnEvent("Click", ClearAllP)
        btnDelAllNo := MG.Add("Button", "x+10 y444 w75 h32 -Theme +Background444444 cWhite +Hidden", "❌ NEI")
        btnDelAllNo.OnEvent("Click", SkjulFjernAlleValg)
        
        MG.SetFont("s8.5 c000000 Bold")
        SKF := MG.Add("Edit", "x380 y30 w320 h30 +Border +BackgroundFFFFFF c000000 +0x200", " Søk i lagrede koder:")
        SKF.OnEvent("Change", (ctl, *)=>ShowL(SKF.Value))
        SKF.OnEvent("Focus", HåndterSKFFokus)
        SKF.OnEvent("LoseFocus", HåndterSKFTapFokus)
        MG.SetFont("s9 c" st.fg " Bold")
        PLB := MG.Add("ListBox", "x380 y68 w320 h235 +VScroll +Background" st.ft " c" st.fg)
        MG.SetFont("s9 cWhite Bold")
        
        MG.Add("Button", "x380 y318 w160 h32 -Theme +Background3A3A3A", "💎 Viktig Kode").OnEvent("Click", (btn, *)=>SetFav(PLB.Value))
        MG.Add("Button", "x380 y360 w160 h32 -Theme +Background3A3A3A", "⭐ Kun Favs").OnEvent("Click", ToggleKunFavoritter)
        MG.Add("Button", "x380 y402 w160 h32 -Theme +Background3A3A3A", "📋 Kopier Valgt").OnEvent("Click", (btn, *)=>CopyP())
        
        btnDelSel := MG.Add("Button", "x380 y444 w160 h32 -Theme +Background3A3A3A", "️ Slett Markert")
        btnDelSel.OnEvent("Click", VisFjernValgtValg)
        btnDelSelYes := MG.Add("Button", "x380 y444 w75 h32 -Theme +Background155724 cWhite +Hidden", "✔️ JA")
        btnDelSelYes.OnEvent("Click", HåndterDelP)
        btnDelSelNo := MG.Add("Button", "x465 y444 w75 h32 -Theme +Background444444 cWhite +Hidden", "❌ NEI")
        btnDelSelNo.OnEvent("Click", SkjulFjernValgtValg)
        
        BtnA5 := MG.Add("Button", "x30 y495 w670 h32 -Theme " (GullModus ? "+BackgroundD4AF37 c000000" : "+Background4A4A4A cWhite"), GullModus ? "⚡ Auto-Fangst: PÅ" : "⚡ Auto-Fangst: AV")
        BtnA5.OnEvent("Click", ToggleGullModus)
        MG.Add("Button", "x30 y537 w670 h35 -Theme +Background4A4A4A", "🔍 Kjør Systemdiagnostikk").OnEvent("Click", HåndterDiagnostikkKlikk)
        MG.Add("Button", "x30 y582 w670 h35 -Theme +Background222222", "✖ Avslutt og Lukk Vindusanlegg").OnEvent("Click", LukkVindusanleggMappe)
        OnMessage(0x0201, HåndterVinduKlikkF6)
        UpdStl(true), ShowL(), MG.Show()
    }
}

HåndterVinduKlikkF6(wParam, lParam, msg, hwnd) {
    global MG
    try {
        if (IsObject(MG) and hwnd = MG.Hwnd) {
            PostMessage(0x00A1, 2, 0, , "ahk_id " MG.Hwnd)
        }
    }
}

HåndterEDFFokus(*) {
    global MG
    try if IsObject(MG)
        WinRedraw("ahk_id " MG.Hwnd)
}

HåndterEDFTapFokus(*) {
    try UpdStl(true)
}

HåndterSKFFokus(*) {
    global MG, SKF
    try if IsObject(MG) {
        SKF.Opt("+BackgroundFFFFFF c000000")
        if (SKF.Value = " Søk i lagrede koder:")
            SKF.Value := ""
        WinRedraw("ahk_id " MG.Hwnd)
    }
}

HåndterSKFTapFokus(*) {
    global SKF
    try {
        if (SKF.Value = "")
            SKF.Value := " Søk i lagrede koder:"
        UpdStl(true)
    }
}

HåndterDiagnostikkKlikk(*) {
    try RunDiag()
}
