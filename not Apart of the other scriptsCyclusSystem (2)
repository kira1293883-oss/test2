HåndterTidsSliderEndring(s, *) {
    global SjekkIntervallms
    SjekkIntervallms := s.Value * 1000
    SetTimer(UtførMappeSkanning, SjekkIntervallms)
}

OppdatertCyclusPanelLive() {
    global lvCyclus, SeparatCyclusKart
    try {
        if !IsSet(lvCyclus) or !IsObject(lvCyclus)
            return
        lvCyclus.Delete()
        if IsSet(SeparatCyclusKart) and HasProp(SeparatCyclusKart, "Length") {
            for idx, element in SeparatCyclusKart {
                lastNed := element.HasOwnProp("lastNed") and element.lastNed
                visPas := lastNed
                        ? ((element.p = "VENTER_PÅ_MATING" or element.p = "") ? "⬇️ Laster ned..." : "⬇️ Laster ned... (pw satt)")
                        : (element.p = "VENTER_PÅ_MATING") ? "⏳ Venter..."
                        : element.p
                lvCyclus.Add(, element.f, visPas)
            }
        }
        lvCyclus.ModifyCol(1, 280)  ; Filnavn
        lvCyclus.ModifyCol(2, 130)  ; Passord
    }
}

; ==============================================================================
; F11-PANEL — FJERN VALGT RAD FRA KØEN
; ==============================================================================
FjernValgtFraKø() {
    global lvCyclus, SeparatCyclusKart
    if !IsSet(lvCyclus) or !IsObject(lvCyclus)
        return
    valgtRad := lvCyclus.GetNext()
    if (valgtRad = 0) {
        ToolTip("⚠️ Ingen rad valgt!")
        SetTimer(() => ToolTip(), -2000)
        return
    }
    valgtFilnavn := lvCyclus.GetText(valgtRad, 1)
    nyKø := []
    for idx, element in SeparatCyclusKart {
        if (element.f != valgtFilnavn)
            nyKø.Push(element)
    }
    SeparatCyclusKart := nyKø
    OppdatertCyclusPanelLive()
    ToolTip("🗑 Fjernet: " valgtFilnavn)
    SetTimer(() => ToolTip(), -2000)
}

; ==============================================================================
; F11-PANEL — TØM HELE KØEN
; ==============================================================================
TømHeleKøen() {
    global SeparatCyclusKart, CyclusTeller, GjeldendeVenteFil, SisteFellesPassord
    if (MsgBox("Er du sikker på at du vil tømme hele køen?", "Bekreft", "YesNo Icon!") = "No")
        return
    SeparatCyclusKart  := []
    CyclusTeller       := 0
    GjeldendeVenteFil  := ""
    SisteFellesPassord := ""
    OppdatertCyclusPanelLive()
    ToolTip("🧹 Køen er tømt!")
    SetTimer(() => ToolTip(), -2000)
}

; ==============================================================================
; F11-PANEL — ÅPNE LOGGFIL (Vellykkede_Passord.txt)
; ==============================================================================
ÅpneLoggFil() {
    global LogF
    stiTilLogg := (IsSet(LogF) and LogF != "") ? LogF : A_Desktop "\Vellykkede_Passord.txt"
    if !FileExist(stiTilLogg) {
        try FileAppend("", stiTilLogg, "UTF-8")
    }
    try Run(stiTilLogg)
    catch as err {
        ToolTip("⚠️ Klarte ikke åpne loggfil: " err.Message)
        SetTimer(() => ToolTip(), -3000)
    }
}

; ==============================================================================
; ALT+F1 — LAGRE KØ TIL FIL
; ==============================================================================
!F1:: UtførAltF1Lagring()

UtførAltF1Lagring() {
    global SeparatCyclusKart, cyclusGui, LogF
    stiTilLogg := (IsSet(LogF) and LogF != "") ? LogF : A_Desktop "\Vellykkede_Passord.txt"
    samletBlokk := ""
    if IsSet(SeparatCyclusKart) and HasProp(SeparatCyclusKart, "Length") {
        for idx, element in SeparatCyclusKart {
            visPas := (element.p == "VENTER_PÅ_MATING") ? "INGEN_PASSORD_GITT" : element.p
            samletBlokk .= element.f " -> " visPas "`r`n"
        }
    }
    try {
        if (samletBlokk != "") {
            FileAppend(samletBlokk, stiTilLogg, "UTF-8")
            SeparatCyclusKart := []
            SoundPlay("*64")
            ToolTip("💾 Lagret til " stiTilLogg "!")
            SetTimer(() => ToolTip(), -3000)
            if IsSet(cyclusGui) and IsObject(cyclusGui)
                cyclusGui.Destroy(), cyclusGui := ""
        }
    }
}

; ==============================================================================
; CTRL+SHIFT+C — HURTIGMATING (feed passord fra markert tekst til neste fil i kø)
; ==============================================================================
^+c:: {
    global SeparatCyclusKart, GjeldendeVenteFil, SisteFellesPassord, GjeldendeGruppeID

    A_Clipboard := ""
    Sleep(150)
    Send("^c")
    if !ClipWait(1.2, 1) {
        ToolTip("⚠️ Ingen passord detektert!")
        SetTimer(() => ToolTip(), -2000)
        return
    }

    rentPassord := Trim(String(A_Clipboard))
    if (rentPassord == "" or rentPassord == GjeldendeVenteFil) {
        ToolTip("⚠️ Ugyldig tekst detektert!")
        SetTimer(() => ToolTip(), -2000)
        return
    }

    SisteFellesPassord := rentPassord
    matingUtført := false
    nesteFilKlar := ""

    if IsSet(SeparatCyclusKart) and IsObject(SeparatCyclusKart) and HasProp(SeparatCyclusKart, "Length") {
        ; Mate KUN den første ledige filen øverst i køen
        for idx, element in SeparatCyclusKart {
            if (element.p == "VENTER_PÅ_MATING" or element.p == "") {
                element.p := rentPassord
                matingUtført := true
                if IsSet(GjeldendeGruppeID)
                    GjeldendeGruppeID++
                SoundPlay("*64")
                break
            }
        }

        Sleep(200)

        ; Finn hvem som er neste i køen
        for idx, element in SeparatCyclusKart {
            if (element.p == "VENTER_PÅ_MATING" or element.p == "") {
                nesteFilKlar := element.f
                break
            }
        }
    }

    if (matingUtført) {
        ToolTip(nesteFilKlar != "" ? "✅ Matet! 🚀 Neste: " nesteFilKlar : "🟢 Alle felt fylt ut!")
        SetTimer(() => ToolTip(), -2500)
        GjeldendeVenteFil := nesteFilKlar
        OppdatertCyclusPanelLive()
    }
}

; ==============================================================================
; CTRL+SHIFT (hold 2 sek) — MANUELL ENKELTFIL-MATING VIA INPUTBOX
; ==============================================================================
^+:: {
    global SeparatCyclusKart

    if !IsSet(SeparatCyclusKart) or !HasProp(SeparatCyclusKart, "Length") or (SeparatCyclusKart.Length == 0) {
        ToolTip("❌ Ingen filer i køen akkurat nå.")
        SetTimer(() => ToolTip(), -2000)
        return
    }

    målElement := ""
    for idx, element in SeparatCyclusKart {
        if (element.p == "VENTER_PÅ_MATING") {
            målElement := element
            break
        }
    }

    if (målElement == "") {
        ToolTip("✅ Alle filer har allerede fått passord!")
        SetTimer(() => ToolTip(), -2500)
        return
    }

    ; Hold-sperre: 2 sekunder
    ToolTip("⏳ Holder Ctrl+Shift for: " målElement.f)
    if (!KeyWait("Ctrl", "T1") or !KeyWait("Shift", "T1")) {
        ToolTip("❌ Avbrutt! Hold i fullt 2 sekunder.")
        SetTimer(() => ToolTip(), -2000)
        return
    }
    ToolTip("⏳ Holder Ctrl+Shift... [Snart klar]")
    if (!KeyWait("Ctrl", "T1") or !KeyWait("Shift", "T1")) {
        ToolTip("❌ Avbrutt! Hold i fullt 2 sekunder.")
        SetTimer(() => ToolTip(), -2000)
        return
    }

    ToolTip("✅ Godkjent!")
    SoundPlay("*64")
    SetTimer(() => ToolTip(), -1500)

    nyttPassord := InputBox("Fil: " målElement.f "`n`nSkriv inn passord:", "Mating av enkeltfil", "w450 h180").Value
    if (nyttPassord != "") {
        målElement.p := nyttPassord
        OppdatertCyclusPanelLive()
        ToolTip("📥 Passord lagret!")
        SetTimer(() => ToolTip(), -2000)
    }
}

; ==============================================================================
; ALT+ENTER — MANUELL UTPAKKING MED 7-ZIP (første fil i køen med passord)
; ==============================================================================
!Enter:: {
    global SeparatCyclusKart, CyclusSperre, CyclusTeller, GjeldendeVenteFil
    global NedlastingsMappe, SuksessMappe, SisteFellesPassord

    aktivFil := "", aktivtPassord := ""
    for idx, element in SeparatCyclusKart {
        if (element.p != "VENTER_PÅ_MATING" and element.p != "" and !(element.HasOwnProp("lastNed") and element.lastNed)) {
            aktivFil := element.f
            aktivtPassord := element.p
            break
        }
    }

    if (aktivFil == "" or aktivtPassord == "") {
        ToolTip("⚠️ Ingen fil med passord klar til utpakking!")
        SetTimer(() => ToolTip(), -2500)
        return
    }

    try {
        CyclusSperre := true
        ToolTip("🚀 Starter utpakking: " aktivFil "...")

        fullSti := ""
        Loop Files, NedlastingsMappe "\" aktivFil ".*" {
            fullSti := A_LoopFilePath
            break
        }
        if (fullSti == "") {
            Loop Files, NedlastingsMappe "\" aktivFil {
                fullSti := A_LoopFilePath
                break
            }
        }

        guiExe := A_ProgramFiles "\7-Zip\7zG.exe"
        if !FileExist(guiExe)
            guiExe := "C:\Program Files\7-Zip\7zG.exe"

        målMappe := SuksessMappe "\" aktivFil
        if !DirExist(målMappe)
            DirCreate(målMappe)

        Run('"' guiExe '" x -p"' aktivtPassord '" -y -aoa "' fullSti '" -o"' målMappe '"')
        ToolTip("⏳ 7-Zip pakker ut — venter på ferdigstilling...")

        ; Vent til 7-Zip er ferdig (maks 3 minutt)
        ProcessWaitClose("7zG.exe", 180)

        ; Ekstra ventetid så Windows slipper fillåsen før TeraCopy rører mappen
        Sleep(3000)

        ToolTip("📦 7-Zip ferdig! TeraCopy starter flytting...")
        HeisMedTeraCopyAsynkron(NedlastingsMappe, SuksessMappe)

        ; Auto-klikk Ignorer hvis TeraCopy viser låst-fil dialog
        SetTimer(AutoIgnorerTeraCopyDialog, 1500)

        ; Vent på at TeraCopy faktisk flytter filene — sjekk mappen, ikke prosessen
        ; TeraCopy lukker ikke alltid seg selv, så filsjekk er kilden til sannhet
        venteRunde := 0
        forrigeAntall := -1
        ingenEndringRunder := 0
        loop {
            venteRunde++
            Sleep(2000)

            gjenværende := 0
            Loop Files, NedlastingsMappe "\*.*" {
                if !RegExMatch(A_LoopFileExt, "i)crdownload|crdwnload|tmp|part")
                    gjenværende++
            }

            ToolTip("⏳ TeraCopy jobber... " gjenværende " fil(er) gjenstår. (Runde " venteRunde ")")

            ; Sjekk om antallet har stått stille i 10 runder (20 sek) — da er TeraCopy ferdig
            if (gjenværende = forrigeAntall)
                ingenEndringRunder++
            else
                ingenEndringRunder := 0
            forrigeAntall := gjenværende

            ; Ferdig når: mappen er tom, ELLER ingen endring på 20 sek, ELLER 15 min timeout
            if (gjenværende = 0 or ingenEndringRunder >= 10 or venteRunde >= 450)
                break
        }

        ; Stopp dialog-watcher og tvangslukk TeraCopy
        SetTimer(AutoIgnorerTeraCopyDialog, 0)
        if ProcessExist("TeraCopy.exe")
            ProcessClose("TeraCopy.exe")

        ToolTip("✅ TeraCopy ferdig! Kø nullstilles.")
        SetTimer(() => ToolTip(), -3000)

    } catch Error as err {
        ToolTip("⚠️ Utpakkingsfeil: " err.Message)
        SetTimer(() => ToolTip(), -3000)
        SetTimer(AutoIgnorerTeraCopyDialog, 0)
        if ProcessExist("TeraCopy.exe")
            ProcessClose("TeraCopy.exe")
    }

    ; Fjerner KUN filen som faktisk ble pakket ut — resten av køen (og deres passord) består
    nyKøEtterUtpakking := []
    for idx, element in SeparatCyclusKart {
        if (element.f != aktivFil)
            nyKøEtterUtpakking.Push(element)
    }
    SeparatCyclusKart := nyKøEtterUtpakking
    CyclusTeller      := SeparatCyclusKart.Length

    ; Finn neste fil som venter på mating (hvis noen)
    GjeldendeVenteFil := ""
    for idx, element in SeparatCyclusKart {
        if (element.p == "VENTER_PÅ_MATING" or element.p == "") {
            GjeldendeVenteFil := element.f
            break
        }
    }

    CyclusSperre := false
    OppdatertCyclusPanelLive()
}

; ==============================================================================
; AUTO-IGNORER TeraCopy sin låst-fil dialog — kjøres som timer mens TeraCopy jobber
; ==============================================================================
AutoIgnorerTeraCopyDialog() {
    if WinExist("TeraCopy - Error") {
        WinActivate("TeraCopy - Error")
        ; Ignorer er tredje knapp: Avbryt=1, Prøv på nytt=2, Ignorer=3
        try ControlClick("Button3", "TeraCopy - Error")
    }
}

; ==============================================================================
; TERACOPY — Flytter kildefiler etter utpakking
; Faller tilbake til Windows move-kommando hvis TeraCopy ikke er installert
; ==============================================================================
HeisMedTeraCopyAsynkron(fraMappe, tilMappe) {
    teraExe := A_ProgramFiles "\TeraCopy\TeraCopy.exe"
    if !FileExist(teraExe)
        teraExe := "C:\Program Files\TeraCopy\TeraCopy.exe"

    if FileExist(teraExe) {
        ; VIKTIG: Send kun mappesti — IKKE \*.* — TeraCopy løser ikke wildcards (Windows feil 123)
        Run('"' teraExe '" Move "' fraMappe '" "' tilMappe '" /Close /Quiet', , "Hide")
    } else {
        ; Fallback: cmd støtter wildcard fint
        Run(A_ComSpec ' /c move "' fraMappe '\*.*" "' tilMappe '"', , "Hide")
    }
}

; ==============================================================================
; MAPPEVAKT — Auto-skanning hvert 2. sekund (konfigurerbart via slider i F11)
; ==============================================================================
UtførMappeSkanning() {
    global SeparatCyclusKart, GjeldendeVenteFil, CyclusTeller, GjeldendeGruppeID
    global CyclusSperre, NedlastingsMappe, StørrelseSjekkKart

    if (CyclusSperre or !IsSet(NedlastingsMappe) or NedlastingsMappe == "" or !DirExist(NedlastingsMappe))
        return

    midlertidigListe := []
    filerSettDenneRunden := Map()   ; brukes til å rydde opp StørrelseSjekkKart for filer som er borte

    Loop Files, NedlastingsMappe "\*.*" {
        ; Hopp over flerdelte .rar-filer (del 2 og oppover) — disse er ikke egne "hoved"-filer
        if RegExMatch(A_LoopFileExt, "^\d+$") and (A_LoopFileExt != "001" and A_LoopFileExt != "1")
            continue
        if RegExMatch(A_LoopFileName, "i)\.part(?:0[2-9]|[2-9]\d*)\.rar$")
            continue

        ; Er dette en kjent midlertidig nedlastingsendelse? Da vet vi den fortsatt laster ned.
        erMidlertidigEndelse := RegExMatch(A_LoopFileExt, "i)crdwnload|crdownload|tmp|part|download|opdownload|\!ut|\!qb|aria2")

        ; Regn ut "ekte" filnavn uten midlertidig endelse + uten hovedendelse, slik at samme
        ; fil gjenkjennes konsekvent enten den fortsatt laster ned eller er ferdig.
        arbeidsNavn := A_LoopFileName
        if (erMidlertidigEndelse)
            SplitPath(arbeidsNavn, , , , &arbeidsNavn)   ; fjerner f.eks. ".crdownload"
        SplitPath(arbeidsNavn, , , , &BareNavn)          ; fjerner hovedendelsen (f.eks. ".rar")

        filerSettDenneRunden[A_LoopFileName] := true

        erFerdig := false

        if (erMidlertidigEndelse) {
            ; Åpenbart fortsatt under nedlasting — vis den i køen, men marker som ikke ferdig
            erFerdig := false
        } else {
            ; --- Størrelsesstabilitet: filen må ha SAMME størrelse to skanninger på rad ---
            ; Dette fanger opp nedlastinger som IKKE bruker en midlertidig endelse
            ; (f.eks. enkelte nettlesere/nedlastingsverktøy skriver rett til sluttfilnavnet
            ; mens den fortsatt lastes ned), slik at vi aldri markerer FERDIG FØR den faktisk er det.
            gjeldendeStørrelse := A_LoopFileSize

            if StørrelseSjekkKart.Has(A_LoopFileName) {
                forrigeStørrelse := StørrelseSjekkKart[A_LoopFileName]
                erFerdig := (forrigeStørrelse == gjeldendeStørrelse)
                StørrelseSjekkKart[A_LoopFileName] := gjeldendeStørrelse
            } else {
                ; Første gang vi ser filen — vis den i køen med en gang, men ikke ferdig ennå
                StørrelseSjekkKart[A_LoopFileName] := gjeldendeStørrelse
                erFerdig := false
            }
        }

        midlertidigListe.Push({Navn: BareNavn, Tid: A_LoopFileTimeCreated, Ferdig: erFerdig})
    }

    ; Rydd opp størrelseskartet for filer som ikke lenger finnes i mappen
    for filnavn in StørrelseSjekkKart.Clone() {
        if !filerSettDenneRunden.Has(filnavn)
            StørrelseSjekkKart.Delete(filnavn)
    }

    ; Sorter: eldste opprettelsesdato øverst (kronologisk rekkefølge etter når filen ble laget)
    if (midlertidigListe.Length > 1) {
        Loop midlertidigListe.Length {
            i := A_Index
            Loop midlertidigListe.Length - i {
                j := A_Index
                if (midlertidigListe[j].Tid > midlertidigListe[j+1].Tid) {
                    temp := midlertidigListe[j]
                    midlertidigListe[j] := midlertidigListe[j+1]
                    midlertidigListe[j+1] := temp
                }
            }
        }
    }

    nyeFiler := false

    for idx, filData in midlertidigListe {
        BareNavn := filData.Navn

        eksisterendeElement := ""
        for idx2, element in SeparatCyclusKart {
            if (element.f == BareNavn) {
                eksisterendeElement := element
                break
            }
        }

        if (eksisterendeElement == "") {
            ; Ny fil oppdaget — legg den i køen MED EN GANG, selv om den fortsatt laster ned
            grpNavn := "GR-" . GjeldendeGruppeID
            SeparatCyclusKart.Push({g: grpNavn, f: BareNavn, p: "VENTER_PÅ_MATING", lastNed: !filData.Ferdig})
            GjeldendeVenteFil := BareNavn
            CyclusTeller++
            nyeFiler := true
        } else if (filData.Ferdig and eksisterendeElement.lastNed) {
            ; Nedlastingen er nå ferdig — fjern "laster ned"-merket (passord kan allerede være satt)
            eksisterendeElement.lastNed := false
            nyeFiler := true
        }
    }

    if (nyeFiler)
        OppdatertCyclusPanelLive()

    ; --- Fjern fra køen filer som ikke lenger finnes i mappen (slettet/flyttet manuelt) ---
    if (SeparatCyclusKart.Length > 0) {
        køEndret := false
        beholdesListe := []
        for idx, element in SeparatCyclusKart {
            finnesFortsatt := false
            Loop Files, NedlastingsMappe "\" element.f ".*" {
                finnesFortsatt := true
                break
            }
            if (!finnesFortsatt) {
                Loop Files, NedlastingsMappe "\" element.f {
                    finnesFortsatt := true
                    break
                }
            }
            if (finnesFortsatt)
                beholdesListe.Push(element)
            else
                køEndret := true
        }
        if (køEndret) {
            SeparatCyclusKart := beholdesListe
            OppdatertCyclusPanelLive()
        }
    }
}
 
