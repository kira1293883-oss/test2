CyclusPanelVelgFra() {
    global NedlastingsMappe, txtFraVisning, cyclusGui
    gjeldende := IsSet(NedlastingsMappe) ? NedlastingsMappe : "R:\all files Wind Roar\test 1"
    if IsSet(cyclusGui) and IsObject(cyclusGui)
        cyclusGui.Opt("-AlwaysOnTop")
    valgt := DirSelect("*" gjeldende, 3, "Velg ny INPUT-mappe:")
    if IsSet(cyclusGui) and IsObject(cyclusGui)
        cyclusGui.Opt("+AlwaysOnTop")
    if (valgt != "") {
        NedlastingsMappe := valgt
        if IsSet(txtFraVisning) and IsObject(txtFraVisning)
            txtFraVisning.Value := valgt
    }
}

CyclusPanelVelgTil() {
    global SuksessMappe, txtTilVisning, cyclusGui
    gjeldende := IsSet(SuksessMappe) ? SuksessMappe : "R:\successfully saved"
    if IsSet(cyclusGui) and IsObject(cyclusGui)
        cyclusGui.Opt("-AlwaysOnTop")
    valgt := DirSelect("*" gjeldende, 3, "Velg ny UTPAKNINGS-mappe:")
    if IsSet(cyclusGui) and IsObject(cyclusGui)
        cyclusGui.Opt("+AlwaysOnTop")
    if (valgt != "") {
        SuksessMappe := valgt
        if IsSet(txtTilVisning) and IsObject(txtTilVisning)
            txtTilVisning.Value := valgt
    }
}

